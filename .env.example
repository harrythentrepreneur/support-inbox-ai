# Postgres connection string (Prisma)
DATABASE_URL=

# Dashboard login: one shared password, and a random secret that signs the session cookie
AUTH_PASSWORD=
AUTH_SECRET=

# OpenAI: drafts replies and extracts issues from email threads
OPENAI_API_KEY=

# Product context for the AI (optional)
PRODUCT_NAME=
# Free-text description of your backend ("core") and frontend ("web") used to route issues
PRODUCT_ARCHITECTURE=
# Replies sent from an address containing this prefix sign off as FOUNDER_SIGNOFF; others as "Support Team"
FOUNDER_EMAIL_PREFIX=
FOUNDER_SIGNOFF=

# Mailbox 1 (IMAP in, SMTP out)
NEXT_PUBLIC_EMAIL_1=
EMAIL_1_USER=
EMAIL_1_PASSWORD=
EMAIL_1_HOST=
EMAIL_1_PORT=993
EMAIL_1_SMTP_HOST=
EMAIL_1_SMTP_PORT=587

# Mailbox 2 (optional)
NEXT_PUBLIC_EMAIL_2=
EMAIL_2_USER=
EMAIL_2_PASSWORD=
EMAIL_2_HOST=
EMAIL_2_PORT=993
EMAIL_2_SMTP_HOST=
EMAIL_2_SMTP_PORT=587

# GitHub: intake repo for issues, plus where "core" and "web" issues belong
GH_PAT=
GH_REPO=
GH_REPO_CORE=
GH_REPO_WEB=
